{
  "models": {
    "plan": {
      "enabled": false,
      "provider": "groq",
      "model": null,
      "reasoningEffort": null,
      "timeoutMs": 8000
    },
    "primary": {
      "provider": "groq",
      "model": "meta-llama/llama-4-scout-17b-16e-instruct",
      "reasoningEffort": null,
      "maxTokens": 512,
      "timeoutMs": 12000
    },
    "vision": {
      "provider": "groq",
      "model": "meta-llama/llama-4-scout-17b-16e-instruct",
      "prompt": "Briefly describe the page layout and key interactive elements in 200 chars.",
      "maxTokens": 256,
      "timeoutMs": 8000
    },
    "reflect": {
      "enabled": false,
      "provider": "groq",
      "model": null,
      "reasoningEffort": null,
      "timeoutMs": 12000,
      "maxReflections": 3,
      "cooldownTurns": 4,
      "budgetTurnFraction": 0.6,
      "savedMaxChars": 8000
    },
    "report": {
      "enabled": false,
      "provider": "groq",
      "model": null,
      "reasoningEffort": null,
      "timeoutMs": 20000
    }
  },

  "chrome": {
    "executablePath": null
  },

  "loop": {
    "maxSteps": 500,
    "shortCircuitOnNoChange": true,
    "pollMs": 300,
    "maxNoChangePolls": 2,
    "maxStuckRepeats": 2,
    "maxEmptyPlans": 3,
    "maxUrlVisits": 4,
    "revisitUrlMatch": "clean",
    "maxSparsePageRetries": 2,
    "sparsePageRetryMs": 150,
    "sparsePageMinNodes": 2,
    "maxSameDirectionScrolls": 3,
    "maxScrollReversals": 3
  },

  "settle": {
    "afterActionMs": 50,
    "maxMs": 800
  },

  "view": {
    "includeText": true,
    "maxTextChars": 60,
    "dedupeText": true,
    "maxListingLines": 30
  },

  "executor": {
    "backend": "cdp",
    "binPath": null,
    "pauseOnUserInput": false,
    "userIdleMs": 400,
    "raiseChromeOnStart": true,
    "humanize": {
      "enabled": false,
      "mouseSpeedPxPerSec": 3000,
      "mouseJitterPx": 0,
      "keystrokeDelayMsMin": 0,
      "keystrokeDelayMsMax": 10,
      "postFocusPauseMs": 20,
      "postClearPauseMs": 10,
      "preClickPauseMsMin": 10,
      "preClickPauseMsMax": 30,
      "scrollDurationMs": 100,
      "scrollJitterPx": 0
    }
  },

  "log": {
    "enabled": true,
    "dir": "logs"
  }
}

