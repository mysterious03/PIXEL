{
  "models": {
    "plan": {
      "enabled": false,
      "provider": "groq",
      "model": null,
      "reasoningEffort": null,
      "timeoutMs": 20000
    },
    "primary": {
      "provider": "ollama",
      "model": "qwen2.5:3b",
      "reasoningEffort": null,
      "maxTokens": 1024,
      "timeoutMs": 45000
    },
    "vision": {
      "provider": "ollama",
      "model": "moondream:latest",
      "prompt": "Briefly describe the page layout and key interactive elements in 200 chars.",
      "maxTokens": 256,
      "timeoutMs": 30000
    },
    "reflect": {
      "enabled": false,
      "provider": "groq",
      "model": null,
      "reasoningEffort": null,
      "timeoutMs": 30000,
      "maxReflections": 3,
      "cooldownTurns": 4,
      "budgetTurnFraction": 0.6,
      "savedMaxChars": 8000
    },
    "report": {
      "enabled": false,
      "provider": "groq",
      "model": null,
      "reasoningEffort": null,
      "timeoutMs": 30000
    }
  },

  "chrome": {
    "executablePath": null
  },

  "loop": {
    "maxSteps": 30,
    "shortCircuitOnNoChange": true,
    "pollMs": 300,
    "maxNoChangePolls": 3,
    "maxStuckRepeats": 3,
    "maxEmptyPlans": 5,
    "maxUrlVisits": 4,
    "revisitUrlMatch": "clean",
    "maxSparsePageRetries": 3,
    "sparsePageRetryMs": 200,
    "sparsePageMinNodes": 2,
    "maxSameDirectionScrolls": 4,
    "maxScrollReversals": 4
  },

  "settle": {
    "afterActionMs": 100,
    "maxMs": 1500
  },

  "view": {
    "includeText": true,
    "maxTextChars": 80,
    "dedupeText": true,
    "maxListingLines": 40
  },

  "executor": {
    "backend": "cdp",
    "binPath": null,
    "pauseOnUserInput": false,
    "userIdleMs": 400,
    "raiseChromeOnStart": true,
    "humanize": {
      "enabled": false,
      "mouseSpeedPxPerSec": 3000,
      "mouseJitterPx": 0,
      "keystrokeDelayMsMin": 0,
      "keystrokeDelayMsMax": 10,
      "postFocusPauseMs": 20,
      "postClearPauseMs": 10,
      "preClickPauseMsMin": 10,
      "preClickPauseMsMax": 30,
      "scrollDurationMs": 100,
      "scrollJitterPx": 0
    }
  },

  "log": {
    "enabled": true,
    "dir": "logs"
  }
}
