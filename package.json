{
  "name": "pixel",
  "version": "2.0.0",
  "description": "PIXEL: On-Device Visual Perception for Lightweight Browser Agents (SIH 2026 Problem Statement 26171 - ISRO / Department of Space)",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "pixel": "./agent.js",
    "pixel-extract": "./cli.js"
  },
  "scripts": {
    "start": "node live.js",
    "live": "node live.js",
    "launch": "node launch.js",
    "extract": "node cli.js --tree --pretty",
    "agent": "node agent.js",
    "test": "node test/privacy.test.js && node test/agent.test.js && node test/test.js",
    "test:privacy": "node test/privacy.test.js",
    "test:e2e": "BROWSER_AGENT_E2E=1 node test/test.js && BROWSER_AGENT_E2E=1 node test/selectText.test.js",
    "test:agent": "node test/agent.test.js",
    "bench": "node bench.js",
    "train-lora": "node tools/train-lora.js"
  },
  "keywords": [
    "pixel",
    "sih2026",
    "isro",
    "on-device-ai",
    "visual-perception",
    "browser-agent",
    "pii-redaction",
    "privacy-first",
    "cdp",
    "chrome",
    "axtree"
  ],
  "author": "mysterious03",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mysterious03/PIXEL.git"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "dependencies": {
    "chrome-remote-interface": "^0.34.0",
    "dotenv": "^17.4.2",
    "markdown-it": "^14.2.0",
    "sharp": "^0.34.5"
  }
}
